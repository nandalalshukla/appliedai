# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Which model the labs use. claude-opus-5-5 is the default.
# To spend less while learning, set claude-haiku-5-5.
AIKIT_MODEL=claude-opus-5-5

# Set to 1 to force offline mock mode (no API calls, no cost).
# Mock mode also turns on automatically when no API key is found.
AIKIT_MOCK=
